---
---
{%- comment -%}
  One paper, economist-style:
    Title (link to the paper)
    with Coauthor A, B, and C · Journal, forthcoming · 2026
    one-line summary (_data/summaries.yml)
    abstract  arxiv  blog  code  [scholar badge]          [picture]
{%- endcomment -%}

{%- comment -%} coauthors = all authors except me, linked via _data/coauthors.yml {%- endcomment -%}
{%- assign n_co = 0 -%}
{%- for author in entry.author_array -%}
  {%- assign last = author.last | remove: '¶' | remove: '&' | remove: '*' | remove: '†' | remove: '^' -%}
  {%- unless site.scholar.last_name contains last and site.scholar.first_name contains author.first -%}
    {%- assign n_co = n_co | plus: 1 -%}
  {%- endunless -%}
{%- endfor -%}
{%- capture coauthors -%}
  {%- assign i = 0 -%}
  {%- for author in entry.author_array -%}
    {%- assign last = author.last | remove: '¶' | remove: '&' | remove: '*' | remove: '†' | remove: '^' -%}
    {%- if site.scholar.last_name contains last and site.scholar.first_name contains author.first -%}{%- continue -%}{%- endif -%}
    {%- assign i = i | plus: 1 -%}
    {%- if i > 1 -%}{% if i == n_co %}{% if n_co > 2 %},{% endif %} and {% else %}, {% endif %}{%- endif -%}
    {%- assign coauthor_url = null -%}
    {%- assign clean_last = last | downcase | remove_accents -%}
    {%- for coauthor in site.data.coauthors[clean_last] -%}
      {%- if coauthor.firstname contains author.first -%}{%- assign coauthor_url = coauthor.url -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if coauthor_url -%}<a href="{{ coauthor_url }}">{{ author.first }} {{ author.last }}</a>{%- else -%}{{ author.first }} {{ author.last }}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%} venue: Journal / In Proceedings, plus additional_info (", forthcoming") {%- endcomment -%}
{%- assign proceedings = 'inproceedings,incollection' | split: ',' -%}
{%- capture venue -%}
  {%- if entry.type == 'article' -%}<em>{{ entry.journal }}</em>
  {%- elsif proceedings contains entry.type -%}<em>{{ entry.booktitle }}</em>
  {%- endif -%}
  {%- if entry.additional_info -%}{{ entry.additional_info | markdownify | remove: '<p>' | remove: '</p>' | strip }}{%- endif -%}
{%- endcapture -%}
{%- assign venue_text = venue | strip_html | strip -%}

{%- comment -%} title link: DOI > arXiv > URL {%- endcomment -%}
{%- if entry.doi -%}{%- assign paper_url = entry.doi | prepend: 'https://doi.org/' -%}
{%- elsif entry.arxiv -%}{%- assign paper_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' -%}
{%- else -%}{%- assign paper_url = entry.url -%}
{%- endif -%}

{%- assign paper_post = site.posts | where: 'paper', entry.zotero_key | first -%}
{%- assign summary = site.data.summaries[entry.zotero_key] -%}

<div class="row paper">
  <div id="{{ entry.key }}" class="col">
    <div class="title">
      {%- if paper_url -%}<a href="{{ paper_url }}">{{ entry.title }}</a>{%- else -%}{{ entry.title }}{%- endif -%}
    </div>

    <div class="meta">
      {%- if coauthors != '' -%}with {{ coauthors }}{%- endif -%}
      {%- if venue_text != '' -%}{% if coauthors != '' %} · {% endif %}{{ venue }}{%- endif -%}
      {%- if entry.year and entry.preprint != 'true' -%}{% if coauthors != '' or venue_text != '' %} · {% endif %}{{ entry.year }}{%- endif -%}
    </div>

    {% if summary %}<div class="summary">{{ summary }}</div>{% endif %}

    <div class="links">
      {% if entry.abstract %}<a class="abstract" role="button">abstract</a>{% endif %}
      {% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arxiv</a>{% endif %}
      {% if entry.pdf %}<a href="{% if entry.pdf contains '://' %}{{ entry.pdf }}{% else %}{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}{% endif %}">pdf</a>{% endif %}
      {% if entry.blog %}<a href="{{ entry.blog }}">blog</a>{% elsif paper_post %}<a href="{{ paper_post.url | relative_url }}">blog</a>{% endif %}
      {% if entry.code %}<a href="{{ entry.code }}">code</a>{% endif %}
      {% if entry.slides %}<a href="{% if entry.slides contains '://' %}{{ entry.slides }}{% else %}{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}{% endif %}">slides</a>{% endif %}
      {% if entry.poster %}<a href="{% if entry.poster contains '://' %}{{ entry.poster }}{% else %}{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}{% endif %}">poster</a>{% endif %}
      {% if entry.supp %}<a href="{% if entry.supp contains '://' %}{{ entry.supp }}{% else %}{{ entry.supp | prepend: '/assets/pdf/' | relative_url }}{% endif %}">appendix</a>{% endif %}
      {% if entry.video %}<a href="{{ entry.video }}">video</a>{% endif %}
      {% if entry.website %}<a href="{{ entry.website }}">website</a>{% endif %}
      {% if site.enable_publication_badges.google_scholar and entry.google_scholar_id %}
        <a
          class="scholar-badge"
          href="https://scholar.google.com/citations?view_op=view_citation&hl=en&user={{ site.scholar_userid }}&citation_for_view={{ site.scholar_userid }}:{{ entry.google_scholar_id }}"
          aria-label="Google Scholar citations"
        >
          {%- capture cites %}{% google_scholar_citations site.scholar_userid entry.google_scholar_id entry.citations %}{% endcapture -%}
          <img src="https://img.shields.io/badge/scholar-{{ cites | strip }}-4285F4?logo=googlescholar&labelColor=beige" alt="{{ cites | strip }} Google Scholar citations">
        </a>
      {% endif %}
    </div>

    {% if entry.abstract %}
      <div class="abstract hidden"><p>{{ entry.abstract }}</p></div>
    {% endif %}
  </div>

  {% if site.enable_publication_thumbnails and entry.preview %}
    <div class="col-4 col-sm-3 col-md-2 paper-preview">
      {% if entry.preview contains '://' %}
        <img class="preview rounded" src="{{ entry.preview }}" alt="">
      {% else %}
        {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' %}
        {% include figure.liquid loading="eager" path=entry_path sizes="200px" class="preview rounded" zoomable=true alt=entry.title %}
      {% endif %}
    </div>
  {% endif %}
</div>
